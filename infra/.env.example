# Copy to infra/.env.production and fill before deployment.
# Use: docker compose --env-file infra/.env.production ...
CLIENT_HOST=souki.io
LIVREUR_HOST=livreur.souki.io
ADMIN_HOST=admin.souki.io
FRONTEND_ORIGINS=https://souki.io,https://livreur.souki.io,https://admin.souki.io
SOUKI_PUBLIC_URL=https://souki.io
DATABASE_URL=
SECRET_KEY=
COOKIE_SECURE=1
SOUKI_DEPOT_NAME=Point Souki
SOUKI_DEPOT_ADDRESS=
SOUKI_DEPOT_CITY=
SOUKI_DEPOT_PHONE=
SOUKI_DEPOT_LAT=
SOUKI_DEPOT_LNG=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# App mobile : clients Google acceptes en plus du site (defaut : clients du projet « SOUKI » souki-514816).
# GOOGLE_MOBILE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
# Sign in with Apple : destinataire attendu dans l'identity token (defaut : io.souki.app).
# APPLE_CLIENT_IDS=io.souki.app
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E83WRB1CEL
# App Google Play (apps/play-store-pwa/README.md) : empreintes SHA-256 de la cle de signature
# Google Play et de la cle d'importation, separees par une virgule (pas des secrets).
ANDROID_APP_SHA256_FINGERPRINTS=
# true seulement une fois l'app publiee sur Google Play ; reconstruire l'image du site ensuite.
NEXT_PUBLIC_ANDROID_APP_PUBLISHED=false
CAMPAIGN_PUBLIC_ORIGIN=https://souki.io
GEMINI_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOUKI <no-reply@souki.app>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@souki.io
