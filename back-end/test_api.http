### Variables
@base = http://localhost:8000
@token = VOTRE_TOKEN_JWT_ICI

### ─────────────────────────────────────────────
### AUTH
### ─────────────────────────────────────────────

### Register
POST {{base}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "phone": "+212612345678",
  "password": "testpassword123",
  "role": "CLIENT"
}

###

### Login
POST {{base}}/auth/login
Content-Type: application/json

{
  "login_id": "test@example.com",
  "password": "testpassword123"
}

###

