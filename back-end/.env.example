# Exemple de configuration backend SOUKI.
# Copier en `.env` et renseigner les vraies valeurs (ne jamais committer `.env`).

# --------- SUPABASE / BASE DE DONNEES ---------
host=
port=6543
user=
password=
dbname=postgres

# --------- SERVICE ROLE KEY ----------
SUPABASE_SERVICE_ROLE_KEY=

# --------- SECRET KEY (JWT) ----------
SECRET_KEY=

# --------- COMMANDE VOCALE (Gemini) ---------
GEMINI_API_KEY=
GEMINI_API_KEY_GPA=

# --------- GROQ (GENERATION PANIER INTELLIGENT) ----------
# Cle API Groq (requise). Modele Llama via l'API Groq en mode JSON.
GROQ_API_KEY=
# Modele par defaut: llama-3.3-70b-versatile
# Alternative plus rapide/economique: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
# Optionnel: TTL (secondes) du cache des compositions par criteres (defaut 600).
# SOUKI_PANIER_CACHE_TTL_SECONDS=600

# --------- GOOGLE OAUTH ----------
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --------- RESEND EMAIL ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOUKI <no-reply@souki.app>
