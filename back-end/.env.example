# Exemple de configuration backend SOUKI.
# Copier en `.env` et renseigner les vraies valeurs (ne jamais committer `.env`).

# --------- SUPABASE / BASE DE DONNEES ---------
host=
port=6543
user=
password=
dbname=postgres

# --------- SERVICE ROLE KEY ----------
SUPABASE_SERVICE_ROLE_KEY=

# --------- SECRET KEY (JWT) ----------
SECRET_KEY=

# --------- COMMANDE VOCALE (Gemini) ---------
GEMINI_API_KEY=
GEMINI_API_KEY_GPA=

# --------- GROQ (GENERATION PANIER INTELLIGENT) ----------
# Cle API Groq (requise). Modele Llama via l'API Groq en mode JSON.
GROQ_API_KEY=
# Modele par defaut: llama-3.3-70b-versatile
# Alternative plus rapide/economique: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
# Optionnel: TTL (secondes) du cache des compositions par criteres (defaut 600).
# SOUKI_PANIER_CACHE_TTL_SECONDS=600

# --------- GOOGLE OAUTH ----------
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --------- RESEND EMAIL ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOUKI <no-reply@souki.app>

# --------- ORIGINES FRONTEND (CORS + CSRF) ----------
# Liste d'origines autorisees, separees par des virgules. OBLIGATOIRE en production
# (SOUKI_ENV=production), sinon le demarrage echoue. En developpement, la valeur par
# defaut couvre localhost:3000/3001.
#
# A noter : le front appelle le backend via le proxy same-origin /backend (cf.
# next.config.mjs). Le middleware Next (front-end/middleware.ts) valide lui-meme que
# la requete est same-origin et retire alors l'en-tete Origin avant de relayer. Il
# n'est donc PAS necessaire de lister ici chaque URL de deploiement ou de preview
# Vercel : cette variable ne concerne que les appels directs au backend.
# FRONTEND_ORIGINS=https://souki.app,https://www.souki.app
#
# Regex d'origines autorisees (optionnelle). Ignoree au profit de la valeur ci-dessus
# si les deux sont definies. En production, aucune regex n'est appliquee par defaut.
# FRONTEND_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?souki\.app$
