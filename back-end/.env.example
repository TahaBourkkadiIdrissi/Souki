# Local development only. Production injects these into the process.
SOUKI_ENV=development
SOUKI_LOAD_ENV_FILES=1
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SECRET_KEY=
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SOUKI_ENABLE_SUPPLIERS=0
SOUKI_PREORDERS=1
SOUKI_SKIP_DB_INIT=1
SOUKI_ENABLE_SCHEDULER=0
SOUKI_DEPOT_NAME=Point Souki
SOUKI_DEPOT_ADDRESS=
SOUKI_DEPOT_CITY=
SOUKI_DEPOT_PHONE=
SOUKI_DEPOT_LAT=
SOUKI_DEPOT_LNG=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOUKI <no-reply@souki.app>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
