{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "souki-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:client"
      ],
      "port": 3000
    },
    {
      "name": "souki-mobile-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/node_modules/expo/bin/cli",
        "start",
        "apps/mobile",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "souki-client-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "souki-client-npm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/client",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "souki-client-prod-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/client",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "BACKEND_INTERNAL_URL": "https://souki.io/backend"
      }
    }
  ]
}
